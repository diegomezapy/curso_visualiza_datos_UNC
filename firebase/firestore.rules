rules_version = '2';
// Reglas de seguridad del aula virtual (Visualización de Datos · FACET-UNC)
// - Cada estudiante lee/escribe solo SU perfil y SU progreso.
// - Las calificaciones oficiales solo las escribe un docente (correo verificado y registrado en /docentes/{correo}).
// - Un docente puede leer todos los perfiles, progresos y calificaciones.
service cloud.firestore {
  match /databases/{database}/documents {

    function signed() { return request.auth != null; }
    function own(uid) { return signed() && request.auth.uid == uid; }
    function docente() {
      return signed() && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/docentes/$(request.auth.token.email));
    }
    function perfilValido(d) {
      return d.keys().hasAll(['nombres', 'apellidos', 'cedula', 'fechaNac', 'sexo', 'departamento', 'ciudad', 'email', 'consentimiento'])
        && d.nombres is string && d.nombres.size() > 0 && d.nombres.size() <= 80
        && d.apellidos is string && d.apellidos.size() > 0 && d.apellidos.size() <= 80
        && d.cedula is string && d.cedula.matches('^[0-9]{4,10}$')
        && d.email == request.auth.token.email
        && d.consentimiento is map;
    }

    match /usuarios/{uid} {
      allow read: if own(uid) || docente();
      allow create: if own(uid) && perfilValido(request.resource.data);
      // la cédula no se puede cambiar (solo el docente puede corregirla)
      allow update: if (own(uid) && perfilValido(request.resource.data) && request.resource.data.cedula == resource.data.cedula) || docente();
      allow delete: if false;
    }

    // Una cédula = una cuenta. Se crea en el mismo lote que el perfil.
    match /cedulas/{cedula} {
      allow create: if signed() && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.cedula == cedula;
      allow read, update, delete: if false;
    }

    match /progreso/{uid} {
      allow read: if own(uid) || docente();
      allow write: if own(uid);
    }

    match /calificaciones/{uid} {
      allow read: if own(uid) || docente();
      allow write: if docente();
    }

    // ===== Foros de discusión =====
    function miembro() {
      return signed() && (exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) || docente());
    }
    function temaValido(d) {
      return d.keys().hasAll(['modulo', 'titulo', 'cuerpo', 'autorUid', 'autorNombre', 'respuestas', 'resuelto', 'fijado', 'cerrado', 'creado', 'actualizado'])
        && d.modulo is int && d.modulo >= 0 && d.modulo <= 8
        && d.titulo is string && d.titulo.size() >= 4 && d.titulo.size() <= 120
        && d.cuerpo is string && d.cuerpo.size() >= 1 && d.cuerpo.size() <= 5000
        && d.autorNombre is string && d.autorNombre.size() >= 1 && d.autorNombre.size() <= 60;
    }
    function respValida(d) {
      return d.keys().hasAll(['cuerpo', 'autorUid', 'autorNombre', 'esDocente', 'solucion', 'creado'])
        && d.cuerpo is string && d.cuerpo.size() >= 1 && d.cuerpo.size() <= 5000
        && d.autorNombre is string && d.autorNombre.size() >= 1 && d.autorNombre.size() <= 60;
    }

    match /foros/{tid} {
      allow read: if miembro();
      allow create: if miembro() && temaValido(request.resource.data)
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.respuestas == 0 && request.resource.data.resuelto == false
        && request.resource.data.fijado == false && request.resource.data.cerrado == false
        && request.resource.data.creado == request.time && request.resource.data.actualizado == request.time;
      allow update: if docente()
        // el autor edita su tema o lo marca como resuelto
        || (signed() && resource.data.autorUid == request.auth.uid && temaValido(request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['titulo', 'cuerpo', 'resuelto', 'actualizado']))
        // cualquier miembro suma o resta 1 al contador al crear/borrar una respuesta
        || (miembro() && !resource.data.cerrado
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respuestas', 'actualizado'])
            && request.resource.data.respuestas >= 0
            && (request.resource.data.respuestas == resource.data.respuestas + 1 || request.resource.data.respuestas == resource.data.respuestas - 1));
      allow delete: if docente() || (signed() && resource.data.autorUid == request.auth.uid && resource.data.respuestas == 0);

      match /respuestas/{rid} {
        allow read: if miembro();
        allow create: if miembro() && respValida(request.resource.data)
          && !get(/databases/$(database)/documents/foros/$(tid)).data.cerrado
          && request.resource.data.autorUid == request.auth.uid
          && request.resource.data.esDocente == docente()
          && request.resource.data.solucion == false
          && request.resource.data.creado == request.time;
        // el autor del tema marca la solución; el docente puede todo
        allow update: if docente()
          || (signed() && get(/databases/$(database)/documents/foros/$(tid)).data.autorUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['solucion']));
        allow delete: if docente() || (signed() && resource.data.autorUid == request.auth.uid);
      }
    }

    // Lista de docentes: se administra solo desde la consola de Firebase.
    match /docentes/{email} {
      allow get: if signed() && request.auth.token.email == email;
      allow list, write: if false;
    }
  }
}
