rules_version = '2';
// Reglas de seguridad del aula virtual (Visualización de Datos · FACET-UNC)
// - Cada estudiante lee/escribe solo SU perfil y SU progreso.
// - Las calificaciones oficiales solo las escribe un docente (correo verificado y registrado en /docentes/{correo}).
// - Las clases grabadas (/clases) las lee cualquier usuario con sesión y las escribe solo un docente.
// - Un docente puede leer todos los perfiles, progresos y calificaciones.
service cloud.firestore {
  match /databases/{database}/documents {

    function signed() { return request.auth != null; }
    function own(uid) { return signed() && request.auth.uid == uid; }
    function docente() {
      return signed() && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/docentes/$(request.auth.token.email));
    }
    function perfilValido(d) {
      return d.keys().hasAll(['nombres', 'apellidos', 'cedula', 'fechaNac', 'sexo', 'departamento', 'ciudad', 'email', 'consentimiento'])
        && d.nombres is string && d.nombres.size() > 0 && d.nombres.size() <= 80
        && d.apellidos is string && d.apellidos.size() > 0 && d.apellidos.size() <= 80
        && d.cedula is string && d.cedula.matches('^[0-9]{4,10}$')
        && d.email == request.auth.token.email
        && d.consentimiento is map;
    }
    // Cada respuesta tiene solo esos 4 campos con su tipo (si falta alguno, la regla falla). No se limita el largo de los textos
    // porque más comprobaciones por respuesta superan el límite de evaluación de Firestore con 15 respuestas.
    function respuestaQuizValida(r) {
      return r.keys().hasOnly(['pregunta', 'respuesta', 'correcta', 'acierto'])
        && r.pregunta is string && r.respuesta is string && r.correcta is string && r.acierto is bool;
    }
    // Se agrupa en bloques para no superar el límite de profundidad de expresiones de las reglas.
    function respuestas5(rs, d) {
      return respuestaQuizValida(rs[d]) && respuestaQuizValida(rs[d + 1]) && respuestaQuizValida(rs[d + 2])
        && respuestaQuizValida(rs[d + 3]) && respuestaQuizValida(rs[d + 4]);
    }
    function intentoValido(d, id) {
      return d.keys().hasOnly(['id', 'uid', 'sesion', 'quizTitulo', 'fecha', 'pct', 'respuestas'])
        && d.keys().hasAll(['id', 'uid', 'sesion', 'quizTitulo', 'fecha', 'pct', 'respuestas'])
        && d.id == id && d.uid == request.auth.uid
        && (d.sesion is int && d.sesion >= 1 && d.sesion <= 8)
        && (d.quizTitulo is string && d.quizTitulo.size() <= 200)
        && (d.fecha is string && d.fecha.size() <= 40)
        && (d.pct is int && d.pct >= 0 && d.pct <= 100)
        && d.respuestas is list
        && (d.respuestas.size() == 5 || d.respuestas.size() == 10 || d.respuestas.size() == 15)
        && respuestas5(d.respuestas, 0)
        && (d.respuestas.size() == 5 || respuestas5(d.respuestas, 5))
        && (d.respuestas.size() <= 10 || respuestas5(d.respuestas, 10));
    }

    match /usuarios/{uid} {
      allow read: if own(uid) || docente();
      allow create: if own(uid) && perfilValido(request.resource.data);
      // la cédula no se puede cambiar (solo el docente puede corregirla)
      allow update: if (own(uid) && perfilValido(request.resource.data) && request.resource.data.cedula == resource.data.cedula) || docente();
      allow delete: if false;
    }

    // Una cédula = una cuenta. Se crea en el mismo lote que el perfil.
    match /cedulas/{cedula} {
      allow create: if signed() && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.cedula == cedula;
      allow read, update, delete: if false;
    }

    match /progreso/{uid} {
      allow read: if own(uid) || docente();
      allow write: if own(uid);
    }

    // Cada intento conserva las respuestas por pregunta sin hacer crecer indefinidamente progreso/{uid}.
    match /respuestas_quiz/{id} {
      allow get: if docente() || (signed() && resource.data.uid == request.auth.uid);
      allow list: if docente();
      allow create: if signed() && intentoValido(request.resource.data, id);
      // Repetir exactamente la misma escritura es idempotente; alterar respuestas guardadas no está permitido.
      allow update: if signed() && resource.data.uid == request.auth.uid
        && request.resource.data == resource.data;
      allow delete: if false;
    }

    match /calificaciones/{uid} {
      allow read: if own(uid) || docente();
      allow write: if docente();
    }

    // Clases grabadas: las leen los usuarios con sesión; solo el docente las crea o edita.
    // "visible:false" oculta la clase en la interfaz (no es secreto: el control real de acceso es el del video en Drive/YouTube).
    match /clases/{id} {
      allow read: if signed();
      allow create, update: if docente() && request.resource.data.keys().hasAll(['titulo', 'url', 'sesion', 'fecha'])
        && request.resource.data.titulo is string && request.resource.data.titulo.size() <= 150
        && request.resource.data.url is string && request.resource.data.url.matches('^https://.*');
      allow delete: if docente();
    }

    // Ajustes del aula: qué elementos ocultó o eliminó (papelera) el docente. Lo lee cualquiera (incluidos invitados sin cuenta); lo escribe solo un docente.
    // Es un control de interfaz, no de seguridad (el contenido sigue en los archivos del sitio).
    match /ajustes/{id} {
      allow read: if true;   // público: también lo leen los invitados (solo contiene qué elementos están ocultos)
      allow create, update: if docente() && id == 'visibilidad'
        && request.resource.data.keys().hasOnly(['ocultos', 'eliminados', 'actualizado'])
        && request.resource.data.ocultos is map && request.resource.data.ocultos.size() <= 400
        && (!('eliminados' in request.resource.data) || (request.resource.data.eliminados is map && request.resource.data.eliminados.size() <= 400));
      allow delete: if false;
    }

    // Lista de docentes: se administra solo desde la consola de Firebase.
    match /docentes/{email} {
      allow get: if signed() && request.auth.token.email == email;
      allow list, write: if false;
    }
  }
}
