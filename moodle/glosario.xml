<?xml version="1.0" encoding="UTF-8"?><GLOSSARY><INFO><NAME>Glosario de visualización de datos</NAME><INTRO>Términos clave del curso.</INTRO><INTROFORMAT>1</INTROFORMAT><ALLOWDUPLICATEDENTRIES>0</ALLOWDUPLICATEDENTRIES><DISPLAYFORMAT>dictionary</DISPLAYFORMAT><SHOWSPECIAL>1</SHOWSPECIAL><SHOWALPHABET>1</SHOWALPHABET><SHOWALL>1</SHOWALL><ALLOWCOMMENTS>0</ALLOWCOMMENTS><USEDYNALINK>1</USEDYNALINK><DEFAULTAPPROVAL>1</DEFAULTAPPROVAL><GLOBALGLOSSARY>0</GLOBALGLOSSARY><ENTBYPAGE>20</ENTBYPAGE><ENTRIES><ENTRY><CONCEPT>Atributo preatentivo</CONCEPT><DEFINITION>Propiedad visual (color, tamaño, orientación, posición) que se detecta casi instantáneamente sin búsqueda serial.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>1</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY><ENTRY><CONCEPT>Data-ink ratio</CONCEPT><DEFINITION>Proporción de la tinta de un gráfico que representa datos (Tufte). Se busca maximizarla eliminando ruido.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>1</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY><ENTRY><CONCEPT>Chartjunk</CONCEPT><DEFINITION>Elementos decorativos que no aportan información (sombras, 3D, fondos recargados).</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>1</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY><ENTRY><CONCEPT>Gestalt</CONCEPT><DEFINITION>Principios de percepción (proximidad, similitud, cierre, continuidad) que explican cómo agrupamos elementos.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>1</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHERENTRY>1</TEACHERENTRY></ENTRY><ENTRY><CONCEPT>Overplotting</CONCEPT><DEFINITION>Superposición de puntos que oculta la densidad; se mitiga con transparencia, jitter, hexbin o densidad.</DEFINITION><FORMAT>1</FORMAT><USEDYNALINK>1</USEDYNALINK><CASESENSITIVE>0</CASESENSITIVE><FULLMATCH>0</FULLMATCH><TEACHER